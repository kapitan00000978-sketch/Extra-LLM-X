# Extra LLM X Configuration
PORT=3000
HOST=0.0.0.0

# Master Admin Key for direct administrative access
MASTER_KEY=elx-master-admin-key

# Client Authentication (set to false if you want open access without client keys)
ENABLE_AUTH=true

# Model cache TTL (in milliseconds, default 1 hour)
MODEL_CACHE_TTL=3600000

# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434

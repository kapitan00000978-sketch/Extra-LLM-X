# Extra LLM X Gateway Configuration
PORT=3000
HOST=0.0.0.0

# Master Admin Key for direct control
MASTER_KEY=elx-master-admin-key

# Client Authentication (set to false for open public testing)
ENABLE_AUTH=true

# Model Cache TTL in milliseconds (default 1 hour)
MODEL_CACHE_TTL=3600000

# Local AI Endpoints (detected automatically if running)
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Mock/Demo Mode (Generates intelligent simulated completions if no external keys are added)
ENABLE_DEMO_FALLBACK=true

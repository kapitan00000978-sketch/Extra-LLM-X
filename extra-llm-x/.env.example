# ==============================================================================
# Extra LLM X — Server & Gateway Configuration
# ==============================================================================
PORT=3000
HOST=0.0.0.0
MASTER_KEY=elx-master-admin-key
ENABLE_AUTH=true
MODEL_CACHE_TTL=3600000
REQUEST_TIMEOUT_MS=60000
ENABLE_DEMO_FALLBACK=true

# ==============================================================================
# Optional: Pre-configured Free AI Provider API Keys
# (You can also add these interactively at http://localhost:3000)
# ==============================================================================
# Groq Cloud (Free LPU, 14.4k req/day) -> https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio / Gemini (Free 1M context) -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (Free tier models :free) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras Cloud (Free Wafer-Scale Llama 3.3 70B) -> https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# SambaNova Cloud (Free DeepSeek-R1 / Llama 3.3) -> https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# GitHub Models (Free GPT-4o / Phi-4 via PAT) -> https://github.com/settings/tokens
GITHUB_TOKEN=

# Mistral AI (Free Codestral & Nemo) -> https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# DeepSeek Official (5M free tokens) -> https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Together AI (Free trial credits) -> https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Fireworks AI (Free developer credits) -> https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=

# Hugging Face (Free serverless inference) -> https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Cloudflare Workers AI (10,000 free neurons/day) -> https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Localhost Models (100% Free & Offline)
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

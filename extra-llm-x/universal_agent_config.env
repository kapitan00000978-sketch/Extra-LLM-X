# ==============================================================================
# UNIVERSAL AGENT HP — EXTRA LLM X FREE GATEWAY CONFIGURATION
# ==============================================================================
# Paste these variables into your Universal-Agent-HP/.env file to route all
# autonomous agent queries through Extra LLM X with zero API subscription costs!

# 1. Primary Autonomous Provider
TITAN_PROVIDER=omni
TITAN_MODEL=extra/auto-free

# 2. Extra LLM X Gateway Connection
OPENAI_API_BASE=http://localhost:3000/v1
OPENAI_BASE_URL=http://localhost:3000/v1
OPENAI_API_KEY=elx-live-universal-agent-free-hub

# 3. Model Tiers (All 100% Free with Automatic Multi-Provider Failover)
# - FAST: Cerebras CS-3 / Groq LPU (Sub-second execution loops)
FAST_MODEL=extra/free-fast

# - CODING: Codestral / Qwen 2.5 Coder 32B / Llama 3.3 70B
CODING_MODEL=extra/free-coding

# - DEEP REASONING: DeepSeek-R1 (SambaNova / Groq / OpenRouter)
REASONING_MODEL=extra/free-reasoning

# - MULTIMODAL VISION: Gemini 2.0 Flash / GPT-4o Free
VISION_MODEL=extra/free-vision

# 4. Agent Autonomous Budget Settings
COGNITIVE_BUDGET=999.00
TITAN_AUTONOMOUS=true
